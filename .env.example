# Optional. Without it the app runs entirely on localStorage — every screen
# works, nothing is persisted beyond the browser.
#
# Neon: create a project, then copy the pooled connection string from
# Dashboard → Connection Details (it ends with `-pooler...neon.tech/...`).
DATABASE_URL=

# Optional. Only used for absolute URLs in the breadcrumb JSON-LD.
NEXT_PUBLIC_SITE_URL=

# Required for the scheduled run at /api/cron/run. Vercel sends it as a
# bearer token; without it the endpoint refuses every request.
CRON_SECRET=

# Optional. Without it alert emails are simply not sent — the in-app
# notification is the guaranteed channel either way.
RESEND_API_KEY=
EMAIL_FROM=

# Optional per provider. A provider with no credentials simply does not appear
# as a button on the login page.
# GitHub: Settings -> Developer settings -> OAuth Apps. Callback URL:
#   https://YOUR-DOMAIN/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: Cloud Console -> Credentials -> OAuth client ID (Web). Redirect URI:
#   https://YOUR-DOMAIN/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
